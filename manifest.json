{
  "manifest_version": 3,
  "name": "Universal Dark",
  "version": "1.0.0",
  "description": "Тёмная тема для всех сайтов в стиле Windows. Сайты с собственной тёмной темой не трогает.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Universal Dark",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Включить/выключить тёмную тему"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/pixels.js",
        "content/color.js",
        "content/transform.js",
        "content/detect.js",
        "content/engine.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
